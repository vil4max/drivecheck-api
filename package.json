{
  "name": "drivecheck-api",
  "version": "0.1.0",
  "private": true,
  "description": "Cached Ubilling aerial-alerts API and status page for Drive Check",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "test": "vitest run",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile=reports/vitest.json",
    "trace": "python3 scripts/spec-trace.py --results reports/vitest.json",
    "check": "npm run typecheck && npm run lint && npm run test:report && npm run trace",
    "bundle": "wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "5.20261003.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "wrangler": "4.151.1"
  }
}
